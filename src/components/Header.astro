---
// Site header: the `tom` wordmark (links home) + the four-section nav.
// `current` marks the active section (rendered as static text, not a link).
// `caret` adds the blinking terminal caret after the wordmark (Home only).
interface Props {
  current?: "method" | "work" | "speaking" | "about";
  caret?: boolean;
}

const { current, caret = false } = Astro.props;

const navLinks = [
  { href: "/method", label: "Method", key: "method" },
  { href: "/work", label: "Work", key: "work" },
  { href: "/speaking", label: "Speaking", key: "speaking" },
  { href: "/about", label: "About", key: "about" },
];
---

<header class="site">
  <span class="wordmark"
    ><a href="/">tom</a>{
      caret && <span class="caret" aria-hidden="true" />
    }</span
  >
  <nav aria-label="Sections">
    {
      navLinks.map((link) =>
        current === link.key ? (
          <span class="here" aria-current="page">
            {link.label}
          </span>
        ) : (
          <a href={link.href}>{link.label}</a>
        ),
      )
    }
  </nav>
</header>
